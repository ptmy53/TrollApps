diff --git a/TrollApps/TrollApps/Views/BrowseView.swift b/TrollApps/TrollApps/Views/BrowseView.swift
index 5a4ce1f..b700e65 100644
--- a/TrollApps/TrollApps/Views/BrowseView.swift
+++ b/TrollApps/TrollApps/Views/BrowseView.swift
@@ -11,13 +11,62 @@ struct AppListView: View {
     var apps: [Application]
     var showFullMode: Bool
 
+    @EnvironmentObject var repoManager: RepositoryManager
+
     var body: some View {
-        List(apps.sorted { $0.name < $1.name }, id: \.self) { app in
-            AppCell(app: app, showFullMode: showFullMode)
-                .listRowInsets(EdgeInsets())
+        List {
+            Section(header: Text("UPDATES")) {
+                if updates.isEmpty {
+                    Text("NO_UPDATES")
+                        .font(.caption)
+                        .foregroundColor(.gray)
+                } else {
+                    ForEach(updates, id: \.self) { app in
+                        AppCell(app: app, showFullMode: showFullMode)
+                            .listRowInsets(EdgeInsets())
+                    }
+                }
+            }
+
+            Section(header: Text("ALL_APPS")) {
+                ForEach(others, id: \.self) { app in
+                    AppCell(app: app, showFullMode: showFullMode)
+                        .listRowInsets(EdgeInsets())
+                }
+            }
         }
         .listStyle(PlainListStyle())
     }
+
+    /// Guncellemesi olan uygulamalar, isme gore A-Z.
+    private var updates: [Application] {
+        apps.filter(isUpdateAvailable).sorted { $0.name < $1.name }
+    }
+
+    /// Kalan uygulamalar, isme gore A-Z (onceki davranis).
+    private var others: [Application] {
+        apps.filter { !isUpdateAvailable($0) }.sorted { $0.name < $1.name }
+    }
+
+    /// Kurulu surumden daha yeni, cihazin iOS surumuyle uyumlu bir surum repoda varsa true.
+    private func isUpdateAvailable(_ app: Application) -> Bool {
+        guard let bundleId = app.bundleIdentifier, !bundleId.isEmpty,
+              repoManager.IsAppInstalled(bundleId) else { return false }
+
+        let latestVersion: String
+        if let versions = app.versions, !versions.isEmpty {
+            // En yeni surum cihazin iOS surumuyle uyumlu degilse, o uygulama Updates'e girmez.
+            guard let compatibleIndex = compatibleVersionIndex(versions) else { return false }
+            latestVersion = versions[compatibleIndex].version
+        } else {
+            // Surum listesi yoksa (bazi repolarda olmuyor) eski davranisa dus: asla gizleme.
+            latestVersion = app.version ?? ""
+        }
+
+        guard !latestVersion.isEmpty else { return false }
+
+        return repoManager.showUpdateButton(version1: latestVersion, BundleID: bundleId) == 1
+    }
 }
 
