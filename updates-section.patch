+                      let results = json["results"] as? [[String: Any]] else {
+                    // Ag/ayristirma hatasi: onbellege yazma, sonraki denemede tekrar sor.
+                    DispatchQueue.main.async {
+                        self.storeLookupsInFlight.subtract(chunk)
+                    }
+                    return
+                }
+                
+                var found: [String: String] = [:]
